# Configuración de base de datos PostgreSQL
INDUX_DB_URL=jdbc:postgresql://localhost:5432/indux
INDUX_DB_USERNAME=indux_user
INDUX_DB_PASSWORD=tu_contrasena_de_base_de_datos

# Seguridad JWT (secreto base64 de al menos 256 bits)
INDUX_JWT_SECRET=tu_secreto_jwt_en_base64_aqui

# Usuario Administrador inicial de la plataforma
INDUX_ADMIN_EMAIL=admin@indux.com
INDUX_ADMIN_PASSWORD=tu_clave_admin_segura

# CORS (URL del frontend permitido)
INDUX_CORS_ORIGEN=http://localhost:4200

# Documentación Swagger / OpenAPI (true/false)
SWAGGER_ENABLED=true
